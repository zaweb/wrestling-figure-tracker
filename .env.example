PORT=5001
MONGO_URL=mongodb://127.0.0.1:27017/wrestling_figures

# sandbox or production
EBAY_ENV=sandbox

EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=

EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=

# Signs the login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Google sign-in. Redirect URIs must match the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key for photo identification (Add Figure panel)
ANTHROPIC_API_KEY=
